{
  "name": "@deepseek-ai/dsh-electron",
  "description": "Electron desktop shell for DeepSeek Harness",
  "version": "0.1.0-rc.5",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc -b && pnpm --dir ../cli exec tsdown && tsdown",
    "start": "pnpm run build && node scripts/launch.mjs",
    "verify:runtime-dependencies": "node scripts/verify-runtime-dependencies.mjs",
    "package": "pnpm run build && pnpm run verify:runtime-dependencies && electron-builder --publish never"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-group": "workspace:^",
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-anonymous-user-id": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-atomic-write": "workspace:^",
    "@deepseek-ai/dsh-bash-local": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^",
    "@deepseek-ai/dsh-client-modules": "workspace:^",
    "@deepseek-ai/dsh-client-ui-directory-picker-native": "workspace:^",
    "@deepseek-ai/dsh-client-ui-aqua": "workspace:^",
    "@deepseek-ai/dsh-code-runtime": "workspace:^",
    "@deepseek-ai/dsh-compaction": "workspace:^",
    "@deepseek-ai/dsh-fs": "workspace:^",
    "@deepseek-ai/dsh-host-apiproxy": "workspace:^",
    "@deepseek-ai/dsh-host-directory-picker-native": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-output-retention": "workspace:^",
    "@deepseek-ai/dsh-sandbox": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-session-telemetry": "workspace:^",
    "@deepseek-ai/dsh-session-title-llm": "workspace:^",
    "@deepseek-ai/dsh-shell": "workspace:^",
    "@deepseek-ai/dsh-spill": "workspace:^",
    "@deepseek-ai/dsh-subagent-in-process-driver": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-timeout": "workspace:^",
    "@deepseek-ai/dsh-web-frontend": "workspace:^",
    "@deepseek-ai/dsh-workflow": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "ai.deepseek.harness",
    "productName": "DeepSeek Harness",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "asarUnpack": [
      "node_modules/@deepseek-ai/**/*"
    ],
    "directories": {
      "output": "../../dist-exe/electron"
    },
    "files": [
      "lib/**/*",
      "cordis.patch.yml",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        "zip"
      ]
    },
    "win": {
      "target": [
        "zip"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "tar.gz"
      ]
    }
  }
}
